Human.Feedback -> Feedback.record
Feedback.record.Ok -> Reward.calculate
Feedback.record.Error -> HumanInTheHealingLoop
Reward.calculate.Ok -> Bandit.update
Reward.calculate.Error -> HumanInTheHealingLoop
Feedback.record.Ok -> Recovery.generateCandidates
