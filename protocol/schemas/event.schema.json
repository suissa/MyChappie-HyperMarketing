{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ahmp:schema:event:2026-09-03",
  "title": "AHMP Event Envelope",
  "type": "object",
  "required": ["id", "protocol", "version", "type", "timestamp", "actor", "payload"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "protocol": {"const": "ahmp"},
    "version": {"const": "2026-09-03"},
    "type": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "correlationId": {"type": "string"},
    "idempotencyKey": {"type": "string"},
    "actor": {
      "type": "object",
      "required": ["role", "id"],
      "properties": {
        "role": {"enum": ["consumer_agent", "merchant_agent", "broker", "presentation_surface", "system"]},
        "id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "payload": true
  },
  "additionalProperties": false
}
